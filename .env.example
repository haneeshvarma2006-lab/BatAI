# Copy to .env for local development. Never commit a real .env.

BAT_ENVIRONMENT=local
BAT_LOG_LEVEL=INFO
BAT_JSON_LOGS=true
BAT_DOCS_ENABLED=true

# Generate with:  python -m bat.cli issue-key --tenant acme --principal alice
# Only the SHA-256 digest is stored; the plaintext is shown once and never again.
BAT_API_KEYS=[{"key_sha256":"<64 hex chars>","tenant_id":"acme","principal_id":"alice","scopes":["sessions:read","sessions:write","agent:invoke","memory:read"]}]

# Native inference (llama-cpp-python). No model server: the .gguf is loaded
# into this process. Requires `pip install llama-cpp-python`.
BAT_MODEL__MODEL_PATH=./models/your-model.Q4_K_M.gguf
BAT_MODEL__NAME=bat-engine
BAT_MODEL__N_CTX=8192
# 0 = CPU only, -1 = offload every layer to GPU.
BAT_MODEL__N_GPU_LAYERS=0
BAT_MODEL__TEMPERATURE=0.2
BAT_MODEL__MAX_TOKENS=2048
# The model serves one generation at a time; callers beyond this are rejected
# with 429 rather than queued behind a deadline they cannot see.
BAT_MODEL__MAX_QUEUE_DEPTH=8
BAT_MODEL__PRELOAD=true

# Embeddings for RAG: a second .gguf loaded with embedding=True. Without it the
# pipeline falls back to a NON-SEMANTIC hash embedder -- fine for wiring tests,
# useless for real retrieval.
BAT_EMBEDDING__MODEL_PATH=./models/nomic-embed-text-v1.5.Q4_K_M.gguf
BAT_EMBEDDING__BATCH_SIZE=16

# Vector store. 'persistent' is single-process only -- with >1 uvicorn worker
# use 'http' against a Chroma server or the workers fight over the file lock.
BAT_VECTOR__MODE=persistent
BAT_VECTOR__PATH=./var/chroma
BAT_VECTOR__CHUNK_SIZE=1000
BAT_VECTOR__CHUNK_OVERLAP=150
BAT_VECTOR__DEFAULT_TOP_K=5
BAT_VECTOR__CONTEXT_TOKEN_BUDGET=1500
# Chunks below this similarity are dropped instead of padding the prompt.
BAT_VECTOR__MIN_SCORE=0.25

# Sessions. 'memory' is per-process and is rejected in production.
BAT_SESSION__BACKEND=memory
BAT_SESSION__TTL_SECONDS=86400
BAT_SESSION__HISTORY_WINDOW=20

BAT_RATE_LIMIT__REQUESTS_PER_SECOND=5
BAT_RATE_LIMIT__BURST=20
BAT_RATE_LIMIT__MAX_CONCURRENT_RUNS=4

BAT_AGENT__MAX_STEPS=6
BAT_AGENT__DEADLINE_S=120
# 0=NONE 1=PURE 2=NETWORK 3=SUBPROCESS 4=SANDBOX. Production requires >=3.
BAT_AGENT__MIN_TOOL_ISOLATION=2
BAT_AGENT__ENABLED_TOOLS=[]
